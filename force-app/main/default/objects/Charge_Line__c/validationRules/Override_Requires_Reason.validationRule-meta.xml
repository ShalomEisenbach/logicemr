<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Override_Requires_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Rate_Override__c, ISBLANK(Override_Reason__c))</errorConditionFormula>
    <errorMessage>An override reason is required for an overridden charge.</errorMessage>
</ValidationRule>
