<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Clinical Summary Bar</masterLabel>
    <description>At-a-glance summaries for problems, allergies, medications, flowsheet findings, results, and procedures. Accepts a Patient or Encounter record Id.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Patient__c</object>
                <object>Encounter__c</object>
            </objects>
            <property
                name="layout"
                type="String"
                default="stack"
                label="Layout"
                description="stack keeps one column. grid tiles sections side by side for wide pages such as Encounter."
            />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
