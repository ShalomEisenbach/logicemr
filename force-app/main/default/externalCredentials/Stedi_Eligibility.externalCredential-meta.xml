<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>Custom auth for Stedi eligibility. The org admin creates the Named Principal and pastes the Stedi API key as parameter ApiKey. Apex never stores the key.</description>
    <externalCredentialParameters>
        <parameterGroup>Stedi_API</parameterGroup>
        <parameterName>Stedi_API</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!$Credential.Stedi_Eligibility.ApiKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Stedi Eligibility</label>
</ExternalCredential>
